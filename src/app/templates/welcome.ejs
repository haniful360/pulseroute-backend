<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to PulseRoute</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f1f5f9; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased;">
  <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#f1f5f9" style="background-color: #f1f5f9; padding: 20px 10px;">
    <tr>
      <td align="center">
        <!-- Main Compact Email Container Card -->
        <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#ffffff" style="max-width: 500px; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 6px 20px rgba(15, 23, 42, 0.08); border: 1px solid #e2e8f0;">
          
          <!-- Compact Header Banner -->
          <tr>
            <td align="center" bgcolor="#0f172a" style="background-color: #0f172a; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 22px 20px 18px 20px; text-align: center;">
              <!-- Brand Logo Badge -->
              <table border="0" cellspacing="0" cellpadding="0" align="center" style="margin: 0 auto 8px auto;">
                <tr>
                  <td bgcolor="#e11d48" style="background-color: #e11d48; padding: 5px 18px; border-radius: 20px; text-align: center;">
                    <span style="color: #ffffff; font-size: 13px; font-weight: 900; letter-spacing: 1px; text-transform: uppercase;">
                      ⚡ PULSEROUTE
                    </span>
                  </td>
                </tr>
              </table>

              <h1 style="color: #ffffff; font-size: 20px; font-weight: 800; margin: 4px 0 2px 0; letter-spacing: -0.3px;">
                Welcome to PulseRoute!
              </h1>
              <p style="color: #94a3b8; font-size: 12px; margin: 0; font-weight: 500;">
                Rapid Emergency Medical & Ambulance Dispatch Platform
              </p>
            </td>
          </tr>

          <!-- Compact Body Content Area -->
          <tr>
            <td bgcolor="#ffffff" style="padding: 22px 24px 18px 24px; background-color: #ffffff;">
              
              <!-- Badge -->
              <div style="margin-bottom: 12px;">
                <span style="display: inline-block; background-color: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; padding: 4px 12px; border-radius: 14px; font-size: 11px; font-weight: 800;">
                  ✓ Verified via Google Sign-In
                </span>
              </div>

              <!-- Greeting -->
              <h2 style="color: #0f172a; font-size: 17px; font-weight: 700; margin: 0 0 6px 0;">
                Hello <%= name %>,
              </h2>

              <p style="color: #475569; font-size: 13px; line-height: 1.5; margin: 0 0 14px 0;">
                Welcome to <strong>PulseRoute</strong>! Your account is now active and ready for fast emergency ambulance dispatch.
              </p>

              <!-- Compact Feature Highlights Box -->
              <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#f8fafc" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; margin: 12px 0;">
                <tr>
                  <td style="padding: 14px 16px;">
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                      <tr>
                        <td width="26" valign="top" style="font-size: 16px; padding-bottom: 8px;">🚑</td>
                        <td valign="top" style="color: #334155; font-size: 12px; line-height: 1.4; padding-bottom: 8px;">
                          <strong>Fast Dispatch:</strong> Book AC, ICU, Basic, or Freezer ambulances.
                        </td>
                      </tr>
                      <tr>
                        <td width="26" valign="top" style="font-size: 16px; padding-bottom: 8px;">📍</td>
                        <td valign="top" style="color: #334155; font-size: 12px; line-height: 1.4; padding-bottom: 8px;">
                          <strong>Live GPS:</strong> Real-time ambulance arrival tracking.
                        </td>
                      </tr>
                      <tr>
                        <td width="26" valign="top" style="font-size: 16px;">💳</td>
                        <td valign="top" style="color: #334155; font-size: 12px; line-height: 1.4;">
                          <strong>Easy Billing:</strong> Instant fare calculations via Stripe or Cash.
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Compact Emergency Alert Box -->
              <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#fff1f2" style="background-color: #fff1f2; border-left: 4px solid #e11d48; border-radius: 0 8px 8px 0; margin-bottom: 14px;">
                <tr>
                  <td style="padding: 8px 12px;">
                    <p style="color: #881337; font-size: 11px; line-height: 1.4; margin: 0;">
                      <strong style="color: #9f1239;">🚨 Emergency Hotline:</strong> Dial <strong>999</strong> for immediate life-saving support.
                    </p>
                  </td>
                </tr>
              </table>

              <p style="color: #94a3b8; font-size: 11px; text-align: center; margin: 0;">
                Account Email: <strong style="color: #475569;"><%= email %></strong>
              </p>
            </td>
          </tr>

          <!-- Compact Footer -->
          <tr>
            <td bgcolor="#f8fafc" style="background-color: #f8fafc; padding: 14px 20px; text-align: center; border-top: 1px solid #e2e8f0;">
              <p style="color: #334155; font-size: 11px; font-weight: 700; margin: 0 0 4px 0;">
                PulseRoute Emergency Healthcare Platform
              </p>
              <p style="color: #64748b; font-size: 11px; margin: 0;">
                Need help? <a href="mailto:support@pulseroute.com" style="color: #e11d48; text-decoration: none; font-weight: 600;">support@pulseroute.com</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
