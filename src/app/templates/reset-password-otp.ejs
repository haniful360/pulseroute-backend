<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PulseRoute Password Reset</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f1f5f9; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased;">
  <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#f1f5f9" style="background-color: #f1f5f9; padding: 20px 10px;">
    <tr>
      <td align="center">
        <!-- Main Compact Container -->
        <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#ffffff" style="max-width: 500px; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 6px 20px rgba(15, 23, 42, 0.08); border: 1px solid #e2e8f0;">
          
          <!-- Compact Header Banner -->
          <tr>
            <td align="center" bgcolor="#e11d48" style="background-color: #e11d48; background: linear-gradient(135deg, #e11d48 0%, #be123c 100%); padding: 22px 20px 18px 20px; text-align: center;">
              <!-- Brand Logo Badge -->
              <table border="0" cellspacing="0" cellpadding="0" align="center" style="margin: 0 auto 8px auto;">
                <tr>
                  <td bgcolor="#ffffff" style="background-color: #ffffff; padding: 5px 18px; border-radius: 20px; text-align: center;">
                    <span style="color: #e11d48; font-size: 13px; font-weight: 900; letter-spacing: 1px; text-transform: uppercase;">
                      ⚡ PULSEROUTE
                    </span>
                  </td>
                </tr>
              </table>

              <h1 style="color: #ffffff; font-size: 20px; font-weight: 800; margin: 4px 0 2px 0; letter-spacing: -0.3px;">
                Password Reset Request
              </h1>
              <p style="color: #ffe4e6; font-size: 12px; margin: 0; font-weight: 500;">
                Rapid Emergency Medical & Ambulance Dispatch Platform
              </p>
            </td>
          </tr>

          <!-- Compact Body Area -->
          <tr>
            <td bgcolor="#ffffff" style="padding: 22px 24px 18px 24px; background-color: #ffffff;">
              
              <!-- Badge -->
              <div style="margin-bottom: 12px;">
                <span style="display: inline-block; background-color: #fee2e2; color: #b91c1c; border: 1px solid #fecdd3; padding: 4px 12px; border-radius: 14px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px;">
                  🔑 Password Reset Code
                </span>
              </div>

              <!-- Greeting -->
              <h2 style="color: #0f172a; font-size: 17px; font-weight: 700; margin: 0 0 6px 0;">
                Hello <%= name %>,
              </h2>

              <p style="color: #475569; font-size: 13px; line-height: 1.5; margin: 0 0 14px 0;">
                We received a request to reset the password for your <strong>PulseRoute</strong> account. Use the one-time verification code (OTP) below to set a new password.
              </p>

              <!-- Compact OTP Container Box -->
              <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#fff1f2" style="background-color: #fff1f2; border: 1.5px dashed #f43f5e; border-radius: 12px; margin: 14px 0; text-align: center;">
                <tr>
                  <td style="padding: 16px 14px;">
                    <div style="color: #9f1239; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 4px;">
                      Reset Code (OTP)
                    </div>
                    <div style="font-family: 'Courier New', Courier, monospace; font-size: 32px; font-weight: 900; color: #e11d48; letter-spacing: 8px; margin: 4px 0;">
                      <%= otp %>
                    </div>
                    <div style="margin-top: 8px;">
                      <table border="0" cellspacing="0" cellpadding="0" align="center" style="margin: 0 auto;">
                        <tr>
                          <td bgcolor="#e11d48" style="background-color: #e11d48; padding: 4px 14px; border-radius: 14px; text-align: center;">
                            <span style="color: #ffffff; font-size: 11px; font-weight: 700;">
                              ⏱ Valid for <%= expirationMinutes %> minutes only
                            </span>
                          </td>
                        </tr>
                      </table>
                    </div>
                  </td>
                </tr>
              </table>

              <p style="color: #64748b; font-size: 12px; line-height: 1.4; margin: 0 0 14px 0;">
                Enter this code on the password reset page along with your new password.
              </p>

              <!-- Security Warning Alert Box -->
              <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#fffbeb" style="background-color: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 0 8px 8px 0; margin-bottom: 14px;">
                <tr>
                  <td style="padding: 10px 12px;">
                    <p style="color: #92400e; font-size: 11px; line-height: 1.4; margin: 0;">
                      <strong style="color: #78350f;">🔒 Security Note:</strong> If you did not request this password reset, please ignore this email. Your password will remain unchanged.
                    </p>
                  </td>
                </tr>
              </table>

              <p style="color: #94a3b8; font-size: 11px; text-align: center; margin: 0;">
                Account: <strong style="color: #475569;"><%= email %></strong>
              </p>
            </td>
          </tr>

          <!-- Compact Footer -->
          <tr>
            <td bgcolor="#f8fafc" style="background-color: #f8fafc; padding: 14px 20px; text-align: center; border-top: 1px solid #e2e8f0;">
              <p style="color: #334155; font-size: 11px; font-weight: 700; margin: 0 0 4px 0;">
                PulseRoute Emergency Healthcare Platform
              </p>
              <p style="color: #64748b; font-size: 11px; margin: 0;">
                Need help? <a href="mailto:support@pulseroute.com" style="color: #e11d48; text-decoration: none; font-weight: 600;">support@pulseroute.com</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>

