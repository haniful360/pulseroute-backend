model DriverWallet {
  id                  String   @id @default(uuid())
  driverId            String   @unique
  driver              Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  balance             Decimal  @default(0.00) @db.Decimal(12, 2)
  totalEarnings       Decimal  @default(0.00) @db.Decimal(12, 2)
  totalCommissionPaid Decimal  @default(0.00) @db.Decimal(12, 2)
  totalWithdrawn      Decimal  @default(0.00) @db.Decimal(12, 2)
  currency            String   @default("BDT")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  transactions   WalletTransaction[]
  payoutRequests PayoutRequest[]

  @@index([driverId], name: "idx_wallet_driverId")
  @@map("driver_wallets")
}

model WalletTransaction {
  id           String               @id @default(uuid())
  walletId     String
  wallet       DriverWallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tripId       String?
  trip         Trip?                @relation(fields: [tripId], references: [id], onDelete: SetNull)
  amount       Decimal              @db.Decimal(12, 2)
  type         TransactionType
  direction    TransactionDirection
  status       TransactionStatus    @default(COMPLETED)
  balanceAfter Decimal              @db.Decimal(12, 2)
  description  String?
  referenceId  String?
  createdAt    DateTime             @default(now())

  @@index([walletId], name: "idx_txn_walletId")
  @@index([tripId], name: "idx_txn_tripId")
  @@index([type], name: "idx_txn_type")
  @@index([createdAt], name: "idx_txn_createdAt")
  @@map("wallet_transactions")
}

model PayoutRequest {
  id                   String        @id @default(uuid())
  driverId             String
  driver               Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  walletId             String
  wallet               DriverWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod
  accountNumber        String
  accountDetails       String?
  status               PayoutStatus  @default(REQUESTED)
  processedAt          DateTime?
  processedById        String?
  processedBy          User?         @relation("PayoutProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  rejectionReason      String?
  transactionReference String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([driverId], name: "idx_payout_driverId")
  @@index([walletId], name: "idx_payout_walletId")
  @@index([status], name: "idx_payout_status")
  @@map("payout_requests")
}
