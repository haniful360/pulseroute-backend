model Driver {
  id                 String                   @id @default(uuid(7))
  name               String
  email              String                   @unique
  contactNumber      String
  licenseNumber      String                   @unique
  licenseExpiry      DateTime?
  nidNumber          String?
  experienceYears    Int                      @default(0)
  verificationStatus DriverVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedById       String?
  rejectionReason    String?
  dutyStatus         DutyStatus               @default(OFFLINE)
  currentLatitude    Float?
  currentLongitude   Float?
  currentHeading     Float?
  lastLocationUpdate DateTime?
  rating             Float                    @default(5.0)
  totalTrips         Int                      @default(0)
  isDeleted          Boolean                  @default(false)
  deletedAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  // Relations
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  verifiedBy User? @relation("DriverVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  currentVehicleId String?  @unique
  currentVehicle   Vehicle? @relation("CurrentDriverVehicle", fields: [currentVehicleId], references: [id], onDelete: SetNull)

  vehicles       Vehicle[]           @relation("DriverOwnedVehicles")
  wallet         DriverWallet?
  trips          Trip[]
  dispatchOffers DispatchOffer[]
  locationLogs   DriverLocationLog[]
  invoices       Invoice[]
  payoutRequests PayoutRequest[]
  reviews        Review[]

  @@index([email], name: "idx_driver_email")
  @@index([contactNumber], name: "idx_driver_contact")
  @@index([licenseNumber], name: "idx_driver_license")
  @@index([verificationStatus], name: "idx_driver_verification")
  @@index([dutyStatus], name: "idx_driver_dutyStatus")
  @@index([currentLatitude, currentLongitude], name: "idx_driver_location")
  @@index([isDeleted], name: "idx_driver_isDeleted")
  @@map("drivers")
}
