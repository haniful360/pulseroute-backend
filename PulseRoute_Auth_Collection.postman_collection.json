{
	"info": {
		"_postman_id": "pulseroute-auth-collection-id",
		"name": "PulseRoute - Auth API Collection",
		"description": "Postman collection for testing PulseRoute Emergency Ambulance Dispatch Platform authentication APIs (Redis OTP Verification, Forgot & Reset Password, Google OAuth Login, User, Driver, Super Admin)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Register User (Patient) - Send OTP",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Rahim Ahmed\",\n    \"email\": \"rahim@example.com\",\n    \"password\": \"password123\",\n    \"contactNumber\": \"+8801711223344\",\n    \"address\": \"House 12, Road 5, Dhanmondi, Dhaka\",\n    \"emergencyContactName\": \"Karim Ahmed\",\n    \"emergencyContactNumber\": \"+8801711223355\",\n    \"bloodGroup\": \"O+\",\n    \"gender\": \"MALE\",\n    \"dateOfBirth\": \"1995-05-15\",\n    \"medicalHistory\": \"Asthma, allergic to penicillin\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"register"
					]
				}
			}
		},
